package com.mmd.json;

import com.google.gson.*;
import java.io.*;
import java.util.*;

public class ConfigurationManager {
    private List<String> primaryKeys;
    private String fallbackKey;
    private JsonObject subSectionKeys;
    private JsonObject ignoredFields;
    private String separator = "|";
    private String reportFileName;

    public ConfigurationManager(String configFile) throws IOException {
        File cfgFile = new File(configFile);

        if (!cfgFile.exists()) {
            throw new FileNotFoundException("Configuration file not found: " + cfgFile.getAbsolutePath());
        }

        try (FileReader reader = new FileReader(cfgFile)) {
            JsonObject config = JsonParser.parseReader(reader).getAsJsonObject();

            // Lecture des clés principales
            JsonElement pkElem = config.get("primary_key");
            this.primaryKeys = new ArrayList<>();
            if (pkElem != null) {
                if (pkElem.isJsonArray()) {
                    for (JsonElement elem : pkElem.getAsJsonArray()) {
                        this.primaryKeys.add(elem.getAsString());
                    }
                } else {
                    this.primaryKeys.add(pkElem.getAsString());
                }
            }

            // Lecture fallback
            this.fallbackKey = config.has("fallback_key") ? config.get("fallback_key").getAsString() : null;

            // Lecture sous-sections
            this.subSectionKeys = config.has("subSectionKeys")
                    ? config.getAsJsonObject("subSectionKeys")
                    : new JsonObject();

            // Lecture des champs ignorés
            this.ignoredFields = config.has("ignored_fields") && config.get("ignored_fields").isJsonObject()
                    ? config.getAsJsonObject("ignored_fields")
                    : new JsonObject();

            // Lecture du séparateur
            this.separator = config.has("separator") ? config.get("separator").getAsString() : "|";

            // Nom du rapport
            this.reportFileName = config.has("reportFileName")
                    ? config.get("reportFileName").getAsString()
                    : "JSONReport";

        } catch (Exception e) {
            throw new IOException("Error reading configuration file: " + e.getMessage(), e);
        }
    }

    public List<String> getPrimaryKeys() { return primaryKeys; }
    public String getFallbackKey() { return fallbackKey; }
    public JsonObject getSubSectionKeys() { return subSectionKeys; }
    public JsonObject getIgnoredFields() { return ignoredFields; }
    public String getSeparator() { return separator; }
    public String getReportFileName() { return reportFileName; }
}
