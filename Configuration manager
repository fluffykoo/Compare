package com.mmd.json;

import com.google.gson.*;
import java.io.*;
import java.util.*;

public class ConfigurationManager {

    private List<String> primaryKeys;
    private String fallbackKey;
    private JsonObject ignoredFields;
    private JsonObject subSectionKeys;
    private String reportFileName;

    public ConfigurationManager(String configFile) throws IOException {
        File file = new File(configFile);
        if (!file.exists()) {
            throw new FileNotFoundException("Configuration file not found: " + configFile);
        }

        try (FileReader reader = new FileReader(file)) {
            JsonObject config = JsonParser.parseReader(reader).getAsJsonObject();

            // primary_key
            this.primaryKeys = new ArrayList<>();
            if (config.has("primary_key")) {
                JsonElement pk = config.get("primary_key");
                if (pk.isJsonArray()) {
                    for (JsonElement el : pk.getAsJsonArray()) {
                        primaryKeys.add(el.getAsString());
                    }
                } else {
                    primaryKeys.add(pk.getAsString());
                }
            }

            // fallback_key
            this.fallbackKey = config.has("fallback_key")
                    ? config.get("fallback_key").getAsString()
                    : null;

            // ignored_fields
            this.ignoredFields = config.has("ignored_fields") && config.get("ignored_fields").isJsonObject()
                    ? config.getAsJsonObject("ignored_fields")
                    : new JsonObject();

            // subSectionKeys (optionnel)
            this.subSectionKeys = config.has("subSectionKeys") && config.get("subSectionKeys").isJsonObject()
                    ? config.getAsJsonObject("subSectionKeys")
                    : new JsonObject();

            // nom du rapport
            this.reportFileName = config.has("reportFileName")
                    ? config.get("reportFileName").getAsString()
                    : "JSON_Report";
        }
    }

    // === Getters ===
    public List<String> getPrimaryKeys() {
        return primaryKeys;
    }

    public String getFallbackKey() {
        return fallbackKey;
    }

    public JsonObject getIgnoredFields() {
        return ignoredFields;
    }

    public JsonObject getSubSectionKeys() {
        return subSectionKeys;
    }

    public String getReportFileName() {
        return reportFileName;
    }
}
