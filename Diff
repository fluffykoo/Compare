package com.mmd.json;

import com.google.gson.JsonElement;

public class Difference {
    private String entityId;
    private ChangeType type;
    private String section;
    private String key;
    private JsonElement oldValue;
    private JsonElement newValue;

    public Difference(String entityId, ChangeType type, String section, String key,
                      JsonElement oldValue, JsonElement newValue) {
        this.entityId = entityId;
        this.type = type;
        this.section = section;
        this.key = key;
        this.oldValue = oldValue;
        this.newValue = newValue;
    }

    public String getEntityId() { return entityId; }
    public ChangeType getType() { return type; }
    public String getSection() { return section; }
    public String getKey() { return key; }
    public JsonElement getOldValue() { return oldValue; }
    public JsonElement getNewValue() { return newValue; }

    @Override
    public String toString() {
        return "Difference{" +
                "entityId='" + entityId + '\'' +
                ", type=" + type +
                ", section='" + section + '\'' +
                ", key='" + key + '\'' +
                ", oldValue=" + (oldValue != null ? oldValue.toString() : "null") +
                ", newValue=" + (newValue != null ? newValue.toString() : "null") +
                '}';
    }
}
