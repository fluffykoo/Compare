package com.mmd.json;

import com.google.gson.*;
import java.io.*;
import java.util.*;

public class JsonComparator {

    private final ConfigurationManager config;

    public JsonComparator(String configFile) throws IOException {
        this.config = new ConfigurationManager(configFile);
    }

    public ConfigurationManager getConfig() {
        return config;
    }

    // === Comparaison principale ===
    public List<Difference> compare(String referenceFile, String newFile) throws IOException {
        JsonArray refArray = JsonParser.parseReader(new FileReader(referenceFile)).getAsJsonArray();
        JsonArray newArray = JsonParser.parseReader(new FileReader(newFile)).getAsJsonArray();

        Map<String, JsonObject> refMap = indexEntities(refArray);
        Map<String, JsonObject> newMap = indexEntities(newArray);

        List<Difference> differences = new ArrayList<>();

        // suppressions et modifications
        for (String id : refMap.keySet()) {
            if (!newMap.containsKey(id)) {
                differences.add(new Difference(id, ChangeType.DELETION, "", "", null, null));
            } else {
                compareEntities(id, refMap.get(id), newMap.get(id), differences);
            }
        }

        // ajouts
        for (String id : newMap.keySet()) {
            if (!refMap.containsKey(id)) {
                differences.add(new Difference(id, ChangeType.ADDITION, "", "", null, null));
            }
        }

        return differences;
    }

    // === Indexation par clé composite ===
    public Map<String, JsonObject> indexEntities(JsonArray array) {
        Map<String, JsonObject> map = new LinkedHashMap<>();
        List<String> primaryKeys = config.getPrimaryKeys();
        String fallbackKey = config.getFallbackKey();

        for (JsonElement elem : array) {
            if (!elem.isJsonObject()) continue;
            JsonObject obj = elem.getAsJsonObject();
            String id = extractCompositeId(obj, primaryKeys, fallbackKey);
            if (id != null) {
                map.put(id, obj);
            }
        }
        return map;
    }

    // === Génération d’une clé ID simple ===
    private String extractCompositeId(JsonObject obj, List<String> primaryKeys, String fallbackKey) {
        StringBuilder sb = new StringBuilder();
        boolean found = false;

        for (String key : primaryKeys) {
            if (obj.has(key)) {
                JsonElement el = obj.get(key);
                if (el.isJsonPrimitive()) {
                    if (found) sb.append("|");
                    sb.append(el.getAsString());
                    found = true;
                }
            }
        }

        if (!found && fallbackKey != null && obj.has(fallbackKey)) {
            JsonElement fb = obj.get(fallbackKey);
            if (fb.isJsonPrimitive()) {
                return fb.getAsString();
            }
        }

        return found ? sb.toString() : null;
    }

    // === Comparaison d’entités ===
    private void compareEntities(String id, JsonObject refObj, JsonObject newObj, List<Difference> differences) {
        for (String key : refObj.keySet()) {
            if (!newObj.has(key)) {
                differences.add(new Difference(id, ChangeType.DELETION, "", key, refObj.get(key), null));
            } else if (!Objects.equals(refObj.get(key), newObj.get(key))) {
                differences.add(new Difference(id, ChangeType.MODIFICATION, "", key, refObj.get(key), newObj.get(key)));
            }
        }
        for (String key : newObj.keySet()) {
            if (!refObj.has(key)) {
                differences.add(new Difference(id, ChangeType.ADDITION, "", key, null, newObj.get(key)));
            }
        }
    }
}
